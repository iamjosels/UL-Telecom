# =============================================================================
# SON-IA — configuración
# Copiar a `.env` y completar. El archivo .env NO se versiona.
# =============================================================================

# --- LLM (Groq) --------------------------------------------------------------
# Obtener en https://console.groq.com/keys
# Si esta variable falta, el sistema NO se cae: run_demo.py y POST /run corren
# en modo determinista con las mismas cifras, sin la narrativa del modelo.
GROQ_API_KEY=gsk_tu_clave_aqui

# Modelos. Verificados como vigentes en producción en Groq (agosto 2026).
# Ojo, esto es contraintuitivo: en el plan GRATUITO el límite de tokens por
# minuto va por modelo, y el modelo pequeño tiene la MITAD de presupuesto
# (llama-3.1-8b-instant 6.000 TPM vs llama-3.3-70b-versatile 12.000 TPM).
# Con el 8b la corrida agotaba su cuota a mitad del cierre; con el 70b termina.
# Con plan de pago tiene sentido volver a poner el 8b en SONIA_MODELO_RAPIDO.
SONIA_MODELO_POTENTE=llama-3.3-70b-versatile
SONIA_MODELO_RAPIDO=llama-3.3-70b-versatile

# --- Robustez ----------------------------------------------------------------
# Segundos que se le conceden al crew antes de completar de forma determinista.
# El cierre con agentes tarda ~70 s; 300 deja margen para los reintentos por
# límite de tokens.
SONIA_TIMEOUT_CREW=300

# Reintentos ante error 429 de Groq. El error indica cuántos segundos esperar
# y el sistema respeta ese tiempo antes de reintentar.
SONIA_REINTENTOS_LLM=5

# Orquestación: "supervisado" (por defecto) corre los 3 agentes en secuencia y
# el supervisor consolida en UNA llamada — cabe en el plan gratuito.
# "jerarquico" usa el Process.hierarchical nativo de CrewAI, donde el supervisor
# delega turno a turno: más fiel al patrón, pero agota el TPM del plan gratuito.
SONIA_PROCESO=supervisado

# Desactiva las invariantes estructurales del loader. Normalmente NO hay que
# tocarlo: desde que las constantes del dataset del demo se movieron a
# tests/test_fixture_demo.py, lo que queda comprobando el cargador vale para
# cualquier corte (clave canónica sin colisiones, fechas de vencimiento
# parseadas, importes numéricos) y es lo que convierte una cifra mala
# silenciosa en un fallo ruidoso. Sólo para depurar un dataset raro.
# SONIA_SIN_ASSERTS=1

# --- Telemetría de CrewAI ----------------------------------------------------
# Sus paneles de trazas rompen el layout de la consola durante el demo.
CREWAI_TELEMETRY_OPT_OUT=true
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
